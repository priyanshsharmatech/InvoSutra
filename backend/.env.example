# MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Secret used to sign JWT tokens (use a long random string)
JWT_SECRET=replace-with-a-long-random-secret

# Google Gemini API key
GEMINI_API_KEY=your-gemini-api-key

# Google OAuth Client ID (optional — enables "Continue with Google").
# Create at Google Cloud Console > APIs & Services > Credentials (OAuth client,
# type "Web application"). Must match VITE_GOOGLE_CLIENT_ID on the frontend.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Port the backend server listens on
PORT=8000

# Comma-separated allowed frontend origins (or * for any)
CLIENT_ORIGIN=http://localhost:5173

# Public URL of the frontend (used for links in emails, e.g. password reset)
APP_URL=http://localhost:5173

# Email (optional) — Gmail SMTP via an App Password.
# Leave blank to disable email features. Requires 2-Step Verification on the
# Google account, then create an App Password at:
# Google Account > Security > 2-Step Verification > App Passwords
GMAIL_USER=your-gmail-address@example.com
GMAIL_APP_PASSWORD=your-gmail-app-password
MAIL_FROM_NAME=InvoSutra

# Where contact-form submissions are delivered (defaults to GMAIL_USER if unset)
CONTACT_EMAIL=your-contact-email@example.com

# Cloudinary (optional) — enables brand logo / signature / stamp uploads.
# From your Cloudinary dashboard (cloudinary.com). Leave blank to disable uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
